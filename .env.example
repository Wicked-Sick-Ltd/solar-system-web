APP_NAME=Solar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The public URL this front-end is served at. Drives canonical URLs, OG tags,
# sitemap and JSON-LD. e.g. https://sol.wickedsick.com
APP_URL=https://solar-system.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# This is a front-end over the Solar System DB REST API. Astronomical data is
# read-only from that backend; this app stores only account + alert data.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Sessions and cache default to the filesystem for low-friction deployment.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Defaults are zero-dependency (no services needed) and CI-safe.
# On Forge with Redis, switch the three lines below to redis and run a queue
# worker — that enables true background stale-while-revalidate. See DEPLOYMENT.md.
QUEUE_CONNECTION=sync
CACHE_STORE=file
# Production (Forge + Redis):
#   QUEUE_CONNECTION=redis
#   CACHE_STORE=redis
#   SESSION_DRIVER=redis
#   REDIS_HOST=127.0.0.1
#   REDIS_PASSWORD=null
#   REDIS_PORT=6379

# --- Solar System DB backend (the read-only REST API this front-end consumes) ---
# Production: the FastAPI backend on its own subdomain (the front-end is
# sol.wickedsick.com; the API is separate). Set this to the deployed host.
# Local dev: run the backend repo's FastAPI server on :8003 (see README).
API_BASE_URL=https://api.sol.wickedsick.com/api/v1
# HTTP timeout in seconds for calls to the backend.
SOLAR_API_TIMEOUT=8

# --- Open Graph share cards ---
# Disk used to cache rendered per-object OG cards. `local` for dev/CI; `s3` in
# production (Ceph RGW — see below). Requires the imagick PHP extension.
OG_DISK=local
# OG_VERSION=v1
# OG_TTL=2592000

# --- S3 object storage (Ceph RGW, s3.wickedsick.com) ---
# Used by the `s3` disk when OG_DISK=s3. Bucket + keys are provisioned per the
# Engineering Wiki runbook; see docs/CEPH-S3.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=https://s3.wickedsick.com
# Virtual-hosted-style addressing (bucket.s3.wickedsick.com); keep false.
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Analytics (Google Analytics 4) ---
# Leave unset to ship no analytics. When set, gtag loads only after the visitor
# accepts analytics cookies in the consent banner.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Newsletter (Mailchimp Marketing API, double opt-in) ---
# Leave the key unset to hide the signup form. Store the real values in 1Password
# and inject them at deploy time — never commit them.
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx

# --- Transactional email ---
# Nothing is sent today (log driver). Postmark is wired up and ready: once the
# sending domain is verified, switch MAIL_MAILER=postmark and set the server token
# (config/services.php reads POSTMARK_API_KEY).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@wickedsick.com
MAIL_FROM_NAME="${APP_NAME}"
# POSTMARK_API_KEY=

# --- what3words (observer panel: paste a ///what.three.words address) ---
# Free API key from https://accounts.what3words.com — 1Password item Shared-Secrets/W3W_API.
# Unset = the option is hidden and such addresses are refused.
# W3W_API_KEY=

# --- Open-Meteo (observer panel: hourly weather outlook, no key required) ---
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
# OPEN_METEO_TIMEOUT=6
# OPEN_METEO_CACHE_SECONDS=1800
